+/*
+ * The CAMCC clock controller node of the sm8150 device tree carries no phandle
+ * (nothing references it) and adding one to a live tree is not safe, so the
+ * camera clocks are resolved by node path when the DT has no clock specifier.
+ */
+struct camss_clk_alias {
+	const char *name;
+	u32 id;
+	bool from_gcc;
+};
+
+static const struct camss_clk_alias camss_clk_aliases[] = {
+	{ "csiphy0", 34, false }, { "csiphy0_timer", 26, false },
+	{ "csiphy1", 35, false }, { "csiphy1_timer", 28, false },
+	{ "csiphy2", 36, false }, { "csiphy2_timer", 30, false },
+	{ "csiphy3", 37, false }, { "csiphy3_timer", 32, false },
+	{ "ife0", 47, false }, { "ife0_axi", 46, false },
+	{ "ife0_csid", 50, false }, { "ife0_cphy_rx", 49, false },
+	{ "ife1", 54, false }, { "ife1_axi", 53, false },
+	{ "ife1_csid", 57, false }, { "ife1_cphy_rx", 56, false },
+	{ "ife_lite", 60, false }, { "ife_lite_axi", 60, false },
+	{ "ife_lite_csid", 63, false }, { "ife_lite_cphy_rx", 62, false },
+	{ "camnoc_axi", 16, false }, { "camnoc_axi_src", 17, false },
+	{ "core_ahb", 23, false }, { "cpas_ahb", 24, false },
+	{ "slow_ahb_src", 91, false },
+	{ "cci0", 19, false }, { "cci1", 21, false },
+	{ "cam_ahb_clk", 8, true }, { "cam_hf_axi", 9, true },
+	{ "cam_sf_axi", 10, true },
+};
+
+struct clk *camss_clk_get(struct device *dev, const char *name)
+{
+	struct of_phandle_args spec;
+	struct device_node *np;
+	struct clk *clk;
+	size_t i;
+
+	clk = devm_clk_get(dev, name);
+	if (!IS_ERR(clk))
+		return clk;
+
+	for (i = 0; i < ARRAY_SIZE(camss_clk_aliases); i++)
+		if (!strcmp(camss_clk_aliases[i].name, name))
+			break;
+	if (i == ARRAY_SIZE(camss_clk_aliases))
+		return clk;
+
+	np = of_find_node_by_path(camss_clk_aliases[i].from_gcc ?
+				  "/soc@0/clock-controller@100000" :
+				  "/soc@0/clock-controller@ad00000");
+	if (!np)
+		return clk;
+
+	memset(&spec, 0, sizeof(spec));
+	spec.np = np;
+	spec.args_count = 1;
+	spec.args[0] = camss_clk_aliases[i].id;
+
+	clk = of_clk_get_from_provider(&spec);
+	of_node_put(np);
+	if (IS_ERR(clk))
+		return clk;
+
+	/*
+	 * Do not register a devres clk_put(): several resource entries map to the
+	 * same CAMCC clock (ife_lite and ife_lite_axi), so devres cleanup would
+	 * clk_put() the same reference twice and crash the kernel after a failed
+	 * probe.  The reference is intentionally kept for the module lifetime.
+	 */
+	return clk;
+}
