+		/* The CAMCC node of sm8150 has no phandle, so the board DT cannot
+		 * describe the CAMSS power domains.  Keep the GDSC state left by
+		 * the bootloader and continue without genpd. */
+		dev_warn(dev, "no power domains defined, continuing without genpd\n");
+		camss->genpd_num = 0;
+		return 0;
 	}
 
