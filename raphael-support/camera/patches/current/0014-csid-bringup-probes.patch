-	if (csid->phy.need_vc_update) {
-		csid->res->hw_ops->configure_stream(csid, enable);
-		csid->phy.need_vc_update = false;
+	/*
+	 * Bring-up: need_vc_update is only set when a set_format actually changes
+	 * something, so a pipeline configured in "try then set" order can reach
+	 * stream-on with the CSID never programmed (CSI2_RX_CFG0 reads 0).  Update
+	 * unconditionally; the write is idempotent.
+	 */
+	csid->res->hw_ops->configure_stream(csid, enable);
+	csid->phy.need_vc_update = false;
+
+	if (enable) {
+		dev_info(csid->camss->dev,
+			 "csid%d state: en_vc=0x%x need_vc=%d lane_cnt=%u lane_assign=0x%x csiphy_id=%u phy_ok=%d\n",
+			 csid->id, csid->phy.en_vc, csid->phy.need_vc_update,
+			 csid->phy.lane_cnt, csid->phy.lane_assign,
+			 csid->phy.csiphy_id, csid->phy.csiphy_id != 0);
+		/* bring-up: does the CSID see a CSI-2 clock at all? 0x100 is
+		 * CSID_CSI2_RX_CFG0, 0x20 the RX irq status, 0x70 the top status */
+		msleep(50);
+		dev_info(csid->camss->dev,
+			 "csid%d rx: cfg0=0x%08x rxirq=0x%08x top=0x%08x phycfg=0x%08x\n",
+			 csid->id,
+			 readl_relaxed(csid->base + 0x100),
+			 readl_relaxed(csid->base + 0x20),
+			 readl_relaxed(csid->base + 0x70),
+			 readl_relaxed(csid->base + 0x30));
 	}
 
 	return 0;
