+/*
+ * Bring-up knob: when set, the SM8250-style per-lane writes (0x004 + 0x40*n,
+ * GLBL_PWR_CFG 0x144, ...) are skipped because on SM8150 those offsets land
+ * inside lane 0's 0x400 block and corrupt the vendor programming.
+ */
+static int camss_vendor_seq_only = 1;
+module_param(camss_vendor_seq_only, int, 0644);
+MODULE_PARM_DESC(camss_vendor_seq_only, "use only the vendor D-PHY v1.1 sequence");
+
+/* Bring-up knob: override the per-lane settle register (offset 0x14) value. */
+static int camss_seq_lane14 = -1;
+module_param(camss_seq_lane14, int, 0644);
+MODULE_PARM_DESC(camss_seq_lane14, "override the per-lane 0x14 settle value");
+
+static void csiphy_apply_vendor_seq(struct csiphy_device *csiphy)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(csiphy_2ph_1_1_seq); i++) {
+		const struct csiphy_vendor_reg *r = &csiphy_2ph_1_1_seq[i];
+
+		u32 val = r->val;
+
+		if (r->off == 0x14 && camss_seq_lane14 >= 0)
+			val = (u32)camss_seq_lane14;
+		if (r->mask) {
+			u32 cur = readl_relaxed(csiphy->base + r->off);
+
+			writel_relaxed((cur & ~r->mask) | (val & r->mask),
+				       csiphy->base + r->off);
+		} else {
+			writel_relaxed(val, csiphy->base + r->off);
+		}
+	}
+}
