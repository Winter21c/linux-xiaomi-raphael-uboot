/*
 * Bring-up knob: when set, the SM8250-style per-lane writes (0x004 + 0x40*n,
 * GLBL_PWR_CFG 0x144, ...) are skipped because on SM8150 those offsets land
 * inside lane 0's 0x400 block and corrupt the vendor programming.
 */
static int camss_vendor_seq_only = 1;
module_param(camss_vendor_seq_only, int, 0644);
MODULE_PARM_DESC(camss_vendor_seq_only, "use only the vendor D-PHY v1.1 sequence");

/* Bring-up knob: override the per-lane settle register (offset 0x14) value. */
/* Bring-up: program the PHY global block at base+0x1000 (vendor sequence). */
static int camss_phy_global = 1;
module_param(camss_phy_global, int, 0644);
MODULE_PARM_DESC(camss_phy_global, "program the CSIPHY global block");

static int camss_phy_rate = -1;	/* index into csiphy_rate_tables, -1 = skip */
module_param(camss_phy_rate, int, 0644);
MODULE_PARM_DESC(camss_phy_rate, "apply the vendor per-data-rate PLL table by index");

static int camss_phy_lane_mask = 0x3;
module_param(camss_phy_lane_mask, int, 0644);
MODULE_PARM_DESC(camss_phy_lane_mask, "value written to the CSIPHY lane-enable register");

static int camss_seq_lane14 = -1;
module_param(camss_seq_lane14, int, 0644);
MODULE_PARM_DESC(camss_seq_lane14, "override the per-lane 0x14 settle value");


/*
 * SM8150 CSIPHY global block: the vendor tables put the reset, IRQ, common and
 * lane-enable registers at 0x1000..0x1084, i.e. one 0x1000 page after the lane
 * registers.  mainline only maps the DT window (0x1000) and never touches this
 * block, which is why the PHY output was never enabled.
 */
static void csiphy_program_global(struct csiphy_device *csiphy)
{
	void __iomem *g = ioremap(csiphy->base_global_phys, 0x1000);

	if (!g) {
		dev_err(csiphy->camss->dev, "cannot map CSIPHY global block\n");
		return;
	}

	dev_info(csiphy->camss->dev,
		 "csiphy gbl before: 0x1000=0x%08x 0x1014=0x%08x 0x1018=0x%08x\n",
		 readl_relaxed(g), readl_relaxed(g + 0x014), readl_relaxed(g + 0x018));

	/* vendor csiphy_reset_enter_reg_2_1_1 / csiphy_reset_exit_reg_2_1_1 */
	writel_relaxed(0x1, g);			/* reset enter */
	usleep_range(1000, 1500);
	writel_relaxed(0x2, g);			/* reset exit, step 1 */
	usleep_range(16000, 17000);
	writel_relaxed(0x0, g);
	usleep_range(128000, 129000);
	writel_relaxed(0xe, g);			/* reset exit final */

	/* csiphy_common_reg_2_1_1 */
	writel_relaxed(0x0,  g + 0x084);
	writel_relaxed(0x1,  g + 0x018);
	writel_relaxed(0x7a, g + 0x01c);

	/* csiphy_irq_reg_2_1_1 */
	writel_relaxed(0xff, g + 0x02c);
	writel_relaxed(0xff, g + 0x030);
	writel_relaxed(0xfb, g + 0x034);
	writel_relaxed(0xff, g + 0x038);
	writel_relaxed(0x7f, g + 0x03c);
	writel_relaxed(0xff, g + 0x040);

	/* vendor per-data-rate PLL programming (D-PHY) */
	if (camss_phy_rate >= 0 &&
	    camss_phy_rate < (int)ARRAY_SIZE(csiphy_rate_tables)) {
		const struct csiphy_rate_tbl *t = &csiphy_rate_tables[camss_phy_rate];
		int i;

		dev_info(csiphy->camss->dev, "csiphy rate table: %s (%u records)\n",
			 t->name, t->count);
		for (i = 0; i < t->count; i++) {
			const struct csiphy_rate_rec *r = &t->recs[i];

			if (r->mask) {
				u32 cur = readl_relaxed(csiphy->base + r->off);

				writel_relaxed((cur & ~r->mask) | (r->val & r->mask),
					       csiphy->base + r->off);
			} else {
				writel_relaxed(r->val, csiphy->base + r->off);
			}
			if (r->delay)
				udelay(r->delay);
		}
	}

	/* csiphy_lane_en_reg_2_1_1 */
	writel_relaxed(camss_phy_lane_mask, g + 0x014);
	usleep_range(200, 400);

	dev_info(csiphy->camss->dev,
		 "csiphy gbl after:  0x1000=0x%08x 0x1014=0x%08x 0x1018=0x%08x\n",
		 readl_relaxed(g), readl_relaxed(g + 0x014), readl_relaxed(g + 0x018));
	iounmap(g);
}

static void csiphy_apply_vendor_seq(struct csiphy_device *csiphy)
{
	int i;

	for (i = 0; i < ARRAY_SIZE(csiphy_2ph_1_1_seq); i++) {
		const struct csiphy_vendor_reg *r = &csiphy_2ph_1_1_seq[i];

		u32 val = r->val;

		if (r->off == 0x14 && camss_seq_lane14 >= 0)
			val = (u32)camss_seq_lane14;
		if (r->mask) {
			u32 cur = readl_relaxed(csiphy->base + r->off);

			writel_relaxed((cur & ~r->mask) | (val & r->mask),
				       csiphy->base + r->off);
		} else {
			writel_relaxed(val, csiphy->base + r->off);
		}
	}
}

/*
 * Bring-up knob: override the DT lane mapping at stream time so the possible
 * wiring permutations can be tried without rebuilding the DTB.  Encoding:
 * (clock_lane << 8) | (data1 << 4) | data0, -1 = keep the DT values.
 */
static int camss_lane_override = -1;
module_param(camss_lane_override, int, 0644);
MODULE_PARM_DESC(camss_lane_override, "override CSIPHY lanes: (clk<<8)|(d1<<4)|d0");

static void csiphy_apply_lane_override(struct csiphy_lanes_cfg *c)
{
	int v = camss_lane_override;

	if (v < 0 || c->num_data < 2)
		return;
	c->data[0].pos = v & 0xf;
	c->data[1].pos = (v >> 4) & 0xf;
	c->clk.pos = (v >> 8) & 0xf;
}

static void csiphy_lanes_enable(struct csiphy_device *csiphy,
				struct csiphy_config *cfg,
				s64 link_freq, u8 lane_mask)
{
	struct csiphy_lanes_cfg *c = &cfg->csi2->lane_cfg;
	u8 settle_cnt;
	u8 val, l = 0;
	int i = 0;

	csiphy_apply_lane_override(c);

	settle_cnt = csiphy_settle_cnt_calc(link_freq, csiphy->timer_clk_rate);

	/* bring-up: dump the lane block before programming it */
	dev_info(csiphy->camss->dev,
		 "csiphy pre link=%lld settle=%u mask=0x%02x num_data=%d clk_pos=%d data_pos=%d,%d glbl_pwr=0x%08x glbl_rst=0x%08x ln0=0x%08x ln1=0x%08x ln2=0x%08x\n",
		 link_freq, settle_cnt, lane_mask, c->num_data, c->clk.pos,
		 c->data[0].pos, c->data[1].pos,
		 readl_relaxed(csiphy->base + 0x144), readl_relaxed(csiphy->base + 0x140),
		 readl_relaxed(csiphy->base + 0x004), readl_relaxed(csiphy->base + 0x044),
		 readl_relaxed(csiphy->base + 0x084));

	writel_relaxed(0x1, csiphy->base +
		       CAMSS_CSI_PHY_GLBL_T_INIT_CFG0);
	writel_relaxed(0x1, csiphy->base +
		       CAMSS_CSI_PHY_T_WAKEUP_CFG0);

	val = 0x1;
	val |= lane_mask << 1;
	writel_relaxed(val, csiphy->base + CAMSS_CSI_PHY_GLBL_PWR_CFG);

	val = cfg->combo_mode << 4;
	writel_relaxed(val, csiphy->base + CAMSS_CSI_PHY_GLBL_RESET);

	for (i = 0; i <= c->num_data; i++) {
		if (i == c->num_data)
			l = CAMSS_CSI_PHY_LN_CLK;
		else
			l = c->data[i].pos;

		if (!camss_vendor_seq_only)
			writel_relaxed(0x10, csiphy->base +
				       CAMSS_CSI_PHY_LNn_CFG2(l));
		writel_relaxed(settle_cnt, csiphy->base +
			       CAMSS_CSI_PHY_LNn_CFG3(l));
		writel_relaxed(0x3f, csiphy->base +
			       CAMSS_CSI_PHY_INTERRUPT_MASKn(l));
		writel_relaxed(0x3f, csiphy->base +
			       CAMSS_CSI_PHY_INTERRUPT_CLEARn(l));
	}

	/* SM8150: replay the vendor D-PHY v1.1 sequence last so it wins */
	csiphy_apply_vendor_seq(csiphy);

	if (camss_phy_global)
		csiphy_program_global(csiphy);

	/* bring-up: after programming, give the PHY 100 ms and read it back */
	msleep(100);
	dev_info(csiphy->camss->dev,
		 "csiphy post pwr=0x%08x rst=0x%08x irqcmd=0x%08x ln0cfg2=0x%08x ln1cfg2=0x%08x ln2cfg2=0x%08x clkcfg2=0x%08x irqsts0=0x%08x irqsts1=0x%08x\n",
		 readl_relaxed(csiphy->base + 0x144),
		 readl_relaxed(csiphy->base + 0x140),
		 readl_relaxed(csiphy->base + 0x164),
		 readl_relaxed(csiphy->base + 0x004 + 0x40 * 0),
		 readl_relaxed(csiphy->base + 0x004 + 0x40 * 1),
		 readl_relaxed(csiphy->base + 0x004 + 0x40 * 2),
		 readl_relaxed(csiphy->base + 0x004 + 0x40 * 3),
		 readl_relaxed(csiphy->base + 0x18c),
		 readl_relaxed(csiphy->base + 0x190));
}

static void csiphy_lanes_disable(struct csiphy_device *csiphy,
				 struct csiphy_config *cfg)
{
	struct csiphy_lanes_cfg *c = &cfg->csi2->lane_cfg;
	u8 l = 0;
	int i = 0;

	for (i = 0; i <= c->num_data; i++) {
		if (i == c->num_data)
			l = CAMSS_CSI_PHY_LN_CLK;
		else
			l = c->data[i].pos;

		writel_relaxed(0x0, csiphy->base +
			       CAMSS_CSI_PHY_LNn_CFG2(l));
	}

	writel_relaxed(0x0, csiphy->base + CAMSS_CSI_PHY_GLBL_PWR_CFG);
}

/*
 * csiphy_isr - CSIPHY module interrupt handler
 * @irq: Interrupt line
 * @dev: CSIPHY device
 *
 * Return IRQ_HANDLED on success
 */
static irqreturn_t csiphy_isr(int irq, void *dev)
{
	struct csiphy_device *csiphy = dev;
	u8 i;

	for (i = 0; i < 8; i++) {
		u8 val = readl_relaxed(csiphy->base +
				       CAMSS_CSI_PHY_INTERRUPT_STATUSn(i));
		writel_relaxed(val, csiphy->base +
			       CAMSS_CSI_PHY_INTERRUPT_CLEARn(i));
		writel_relaxed(0x1, csiphy->base + CAMSS_CSI_PHY_GLBL_IRQ_CMD);
		writel_relaxed(0x0, csiphy->base + CAMSS_CSI_PHY_GLBL_IRQ_CMD);
		writel_relaxed(0x0, csiphy->base +
			       CAMSS_CSI_PHY_INTERRUPT_CLEARn(i));
	}

	return IRQ_HANDLED;
}

